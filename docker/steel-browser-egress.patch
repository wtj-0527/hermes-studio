diff --git a/api/src/utils/requests.ts b/api/src/utils/requests.ts
index 4f8aea7..4ff60db 100644
--- a/api/src/utils/requests.ts
+++ b/api/src/utils/requests.ts
@@ -0,0 +1,2 @@
+import { isIP } from "node:net";
+
@@ -100,0 +103,49 @@ export function compileUrlPatterns(patterns: string[]): RegExp[] {
+export function isLocalNetworkRequest(parsed: URL): boolean {
+  const hostname = parsed.hostname.toLowerCase().replace(/^\[|\]$/g, "").replace(/\.$/, "");
+  if (hostname === "localhost" || hostname.endsWith(".localhost")) return true;
+
+  const family = isIP(hostname);
+  if (family === 4) {
+    const octets = hostname.split(".").map(Number);
+    const [a, b] = octets;
+    return (
+      a === 0 ||
+      a === 10 ||
+      a === 127 ||
+      (a === 100 && b >= 64 && b <= 127) ||
+      (a === 169 && b === 254) ||
+      (a === 172 && b >= 16 && b <= 31) ||
+      (a === 192 && b === 168) ||
+      a >= 224
+    );
+  }
+
+  if (family === 6) {
+    const normalized = hostname.toLowerCase();
+    if (normalized === "::" || normalized === "::1") return true;
+    if (normalized.startsWith("::ffff:")) {
+      const mapped = normalized.slice("::ffff:".length);
+      if (isIP(mapped) === 4) return isLocalNetworkRequest(new URL(`http://${mapped}`));
+      const parts = mapped.split(":");
+      if (parts.length === 2 && parts.every((part) => /^[0-9a-f]{1,4}$/.test(part))) {
+        const high = Number.parseInt(parts[0], 16);
+        const low = Number.parseInt(parts[1], 16);
+        const ipv4 = `${high >> 8}.${high & 0xff}.${low >> 8}.${low & 0xff}`;
+        return isLocalNetworkRequest(new URL(`http://${ipv4}`));
+      }
+      return true;
+    }
+    const first = Number.parseInt(normalized.split(":", 1)[0] || "0", 16);
+    return (
+      (first & 0xfe00) === 0xfc00 ||
+      (first & 0xffc0) === 0xfe80 ||
+      (first & 0xff00) === 0xff00 ||
+      normalized.startsWith("100:") ||
+      normalized.startsWith("2001:2:") ||
+      normalized.startsWith("2001:db8:")
+    );
+  }
+
+  return false;
+}
+
